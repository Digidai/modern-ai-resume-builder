{
  "name": "modern-ai-resume-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/seo-postbuild.mjs",
    "build:clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});\" && npm run build",
    "build:deploy": "npm run build && npx wrangler deploy",
    "seo:postbuild": "node scripts/seo-postbuild.mjs",
    "jobtitles:validate": "node scripts/jobtitles-validate.mjs",
    "roles:sync": "node scripts/roles-sync.mjs",
    "roles:fit:apply": "node scripts/roles-fit-apply.mjs",
    "jobtitles:import": "node scripts/jobtitles-import.mjs",
    "sitemap:submit": "node scripts/submit-sitemap.mjs",
    "deploy": "npx wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/charis-sil": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/tinos": "^5.3.0",
    "html-to-image": "^1.11.13",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "googleapis": "^188.0.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
