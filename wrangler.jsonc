{
  "name": "modern-ai-resume-builder",
  "main": "worker/index.ts",
  // "Gene Dai Account" — the account that serves genedai.cv.
  "account_id": "48d9ccaf5ee7914c803b5d0656462848",
  "compatibility_date": "2025-12-13",
  // @cloudflare/puppeteer (Browser Rendering client) needs Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // HTML must pass through the Worker so it gets the CSP nonce, security headers,
    // and the injected `ai-client-token`; by default matching assets bypass the Worker.
    // Hashed bundles, fonts, and OG images don't need it.
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/og/*"]
  },
  // Workers AI; model and options are set in "vars" below. `remote` lets `wrangler dev` call it.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Browser Rendering prints resumes to vector PDF (/api/pdf). `remote` lets `wrangler dev` use it too.
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  // Workers Logs keeps the Worker's console output (render, AI and ORCID failures, rate-limit warnings;
  // never resume content) searchable in the dashboard. Per-request invocation logs are off: every page
  // view runs the Worker, and the console lines are what explain failures.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-rate-limiter",
      "new_classes": ["RateLimiter"]
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "AI_REASONING_EFFORT": "low",
    "AI_RATE_LIMIT_PER_MINUTE": "20",
    "AI_PER_SESSION_RATE_LIMIT_PER_MINUTE": "20",
    "AI_GLOBAL_RATE_LIMIT_PER_MINUTE": "240",
    "AI_SESSION_RATE_LIMIT_PER_MINUTE": "60",
    "AI_SESSION_TTL_SECONDS": "600",
    "AI_CLIENT_TOKEN_TTL_SECONDS": "86400"
  }
}
